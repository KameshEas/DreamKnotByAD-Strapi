{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "E-commerce products"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "base_price": {
      "type": "decimal",
      "required": true
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "products"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "featured": {
      "type": "boolean",
      "required": false
    },
    "delivery_option": {
      "type": "enumeration",
      "enum": ["two_day", "standard", "express"],
      "required": false
    },
    "stock_quantity": {
      "type": "integer",
      "required": false,
      "default": 0
    },
    "is_available": {
      "type": "boolean",
      "required": false,
      "default": true
    },
    "sku": {
      "type": "string",
      "required": false,
      "unique": true
    },
    "weight": {
      "type": "decimal",
      "required": false
    },
    "dimensions": {
      "type": "text",
      "required": false
    },
    "low_stock_threshold": {
      "type": "integer",
      "required": false,
      "default": 5
    }
  }
}
